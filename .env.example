# ===================================================
# CONFIGURAÇÃO DE AMBIENTE - CAPUTO AÇÕES
# ===================================================

# Porta do servidor local
PORT=3000

# Chave secreta para assinatura dos tokens JWT (essencial em produção)
JWT_SECRET=caputo_acoes_secret_key_super_segura_2026

# Credenciais de acesso ao Painel Administrativo (/admin)
ADMIN_EMAIL=admin@caputo.com

# Senha em texto puro (para uso rápido/desenvolvimento):
ADMIN_PASSWORD=caputo123

# Ou Senha com Hash Bcrypt (RECOMENDADO para Produção):
# Gere seu hash executando: npm run hash "sua_senha"
ADMIN_PASSWORD_HASH=

# ===================================================
# BANCO DE DADOS EM NUVEM (OBRIGATÓRIO NA VERCEL)
# ===================================================
# Se preenchido, usa MongoDB Atlas. Se vazio, usa data/db.json localmente.
# Exemplo: mongodb+srv://usuario:senha@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=caputo_acoes

# ===================================================
# CLOUDINARY (UPLOAD PERMANENTE DE FOTOS E FLYERS)
# ===================================================
# Crie uma conta gratuita em https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
